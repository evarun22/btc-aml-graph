# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_strong_password
NEO4J_DATABASE=neo4j

# Blockchain API
BLOCKCHAIN_API_BASE=https://blockchain.info
REQUEST_TIMEOUT_SECONDS=30
REQUEST_SLEEP_SECONDS=0.5

# Pipeline
HEURISTIC_VERSION=v1-utxo-proportional
MAX_PROPORTIONAL_PAIRS_PER_TX=20000
DUST_SATOSHI=546

# Paths
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
OFAC_DIR=./data/ofac

# Logging
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8000

# AI (optional later)
AI_PROVIDER=disabled
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
