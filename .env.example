# Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_strong_password
NEO4J_DATABASE=neo4j
CORS_ORIGINS=http://localhost:3000
MONITOR_INTERVAL=600
MONITOR_LIMIT=10
ANALYTICS_EVERY=100


# Blockchain API
BLOCKCHAIN_API_BASE=https://blockchain.info
REQUEST_TIMEOUT_SECONDS=30
REQUEST_SLEEP_SECONDS=0.5

# Pipeline
HEURISTIC_VERSION=v1-utxo-proportional
MAX_PROPORTIONAL_PAIRS_PER_TX=20000
DUST_SATOSHI=546

# Paths
DATA_DIR=./data
RAW_DATA_DIR=./data/raw
PROCESSED_DATA_DIR=./data/processed
OFAC_DIR=./data/ofac

# Logging
LOG_LEVEL=INFO

# API
API_HOST=0.0.0.0
API_PORT=8010

# AI
AI_PROVIDER=disabled
AI_TIMEOUT_SECONDS=300
AI_CONNECT_TIMEOUT_SECONDS=5
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=600
AI_MAX_CONTEXT_ITEMS=10
AI_MAX_STRING_CHARS=500
AI_MAX_PROMPT_CHARS=12000
AI_AUDIT_LOG=true
AI_AUDIT_LOG_PATH=logs/ai_audit.jsonl


# llama.cpp / OpenAI-compatible local model
LLAMACPP_BASE_URL=http://127.0.0.1:8080
LLAMACPP_MODEL=
